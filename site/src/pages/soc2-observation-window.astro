const title = 'The Observation Window';
const description = 'Why the SOC 2 Type II start date sets your report date: the three-to-six-month observation window is calendar time no platform compresses. What readiness work moves, and what it cannot.';
---

<BaseLayout title={title} description={description} path="/soc2-observation-window">
<div class="explainer">
<div class="wrap">

<section class="hero">
  <p class="eyebrow">Eagle Ridge Advisory · SOC 2 Type II</p>
  <div class="prose">
    <h1>The observation window</h1>
    <p class="dek">When an enterprise customer asks for your SOC&nbsp;2, they mean a
    <strong>Type&nbsp;II report</strong>&thinsp;&mdash;&thinsp;an independent CPA firm attesting that
    your controls <em>operated</em> over a window of <strong class="accent">three to
    six months of real time</strong>. That window is calendar time. No platform
    and no budget compresses it.</p>
    <p>So your start date sets the date you can hand a customer a report. If a
    customer asks today, the earliest credible Type&nbsp;II report is about
    <strong>eight months out</strong>&thinsp;&mdash;&thinsp;and every week of delay moves it a week.</p>
  </div>

  <p class="figtag">Fig. 01 &middot; Why the start date is the whole game</p>
  <figure>
    <svg viewBox="0 0 860 330" width="860" height="330" role="img"
         aria-label="Timeline: readiness, remediation, a fixed three-month observation window, the CPA audit, and the report; a ghost copy shifted two months later shows the report slipping two months">
      <defs>
        <pattern id="win" width="7" height="7" patternTransform="rotate(45)"
                 patternUnits="userSpaceOnUse">
          <rect width="7" height="7" fill="#FAF7F0"/>
          <line x1="0" y1="0" x2="0" y2="7" stroke="#9A8E7A" stroke-width="2.4"/>
        </pattern>
      </defs>
      <!-- month grid: x = 150 + (m-1)*78 -->
      <g class="ax" text-anchor="middle">
        <text x="150" y="20">mo 1</text><text x="228" y="20">mo 2</text>
        <text x="306" y="20">mo 3</text><text x="384" y="20">mo 4</text>
        <text x="462" y="20">mo 5</text><text x="540" y="20">mo 6</text>
        <text x="618" y="20">mo 7</text><text x="696" y="20">mo 8</text>
        <text x="774" y="20">mo 9</text>
      </g>
      <g stroke="#EAE4D4" stroke-width="1">
        <line x1="150" y1="28" x2="150" y2="216"/><line x1="228" y1="28" x2="228" y2="216"/>
        <line x1="306" y1="28" x2="306" y2="216"/><line x1="384" y1="28" x2="384" y2="216"/>
        <line x1="462" y1="28" x2="462" y2="216"/><line x1="540" y1="28" x2="540" y2="216"/>
        <line x1="618" y1="28" x2="618" y2="216"/><line x1="696" y1="28" x2="696" y2="216"/>
        <line x1="774" y1="28" x2="774" y2="216"/><line x1="852" y1="28" x2="852" y2="216"/>
      </g>
      <g class="lbl" text-anchor="end">
        <text x="140" y="55">readiness assessment</text>
        <text x="140" y="93">remediation &amp; design</text>
        <text x="140" y="131">observation window</text>
        <text x="140" y="169">CPA audit</text>
        <text x="140" y="207">report</text>
      </g>
      <rect x="150" y="38" width="76" height="24" rx="4" fill="#9A8E7A"><title>Month 1: every criterion assessed, gaps identified</title></rect>
      <rect x="228" y="76" width="154" height="24" rx="4" fill="#B14E26"><title>Months 2&#8211;3: the heavy lift &#8212; policies, control design, evidence automation</title></rect>
      <rect x="384" y="114" width="232" height="24" rx="4" fill="url(#win)" stroke="#9A8E7A" stroke-width="1.5"><title>Months 4&#8211;6: controls operate and accrue evidence &#8212; fixed calendar time</title></rect>
      <text x="500" y="131" text-anchor="middle" class="lbl-b">fixed &middot; can&rsquo;t compress</text>
      <rect x="618" y="152" width="76" height="24" rx="4" fill="none"
            stroke="#B14E26" stroke-width="2" stroke-dasharray="5 4"><title>Month 7: the independent CPA firm examines the window</title></rect>
      <text x="656" y="145" text-anchor="middle" class="ax">their exam, our prep</text>
      <path d="M 706 194 l 6 12 l 13 2 l -9.5 9 l 2.5 13 l -12 -6.5 l -12 6.5 l 2.5 -13 l -9.5 -9 l 13 -2 z"
            fill="#B14E26"><title>Month 8: the signed Type II report</title></path>
      <text x="742" y="207" class="num-t">report in hand</text>

      <!-- ghost scenario: start two months later -->
      <line x1="30" y1="240" x2="830" y2="240" stroke="#D9D0BF" stroke-width="1"/>
      <text x="140" y="273" text-anchor="end" class="lbl">start 2 months later</text>
      <g opacity="0.45">
        <rect x="306" y="256" width="76" height="20" rx="4" fill="#9A8E7A"/>
        <rect x="384" y="256" width="154" height="20" rx="4" fill="#B14E26"/>
        <rect x="540" y="256" width="232" height="20" rx="4" fill="url(#win)" stroke="#9A8E7A"/>
        <rect x="774" y="256" width="76" height="20" rx="4" fill="none"
